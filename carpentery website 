<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Grained & Grain – Carpenter Tools & Services</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --oak:    #C8915A;
      --walnut: #3B2314;
      --cream:  #F5EFE6;
      --sand:   #E8D8C3;
      --dark:   #1A0F09;
      --sage:   #7A8C6E;
      --rust:   #B54A1F;
      --light:  #FAF6F1;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--light);
      color: var(--walnut);
      overflow-x: hidden;
    }

    /* ─── CURSOR ─── */
    body { cursor: none; }
    #cursor {
      width: 18px; height: 18px;
      border: 2px solid var(--oak);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9999;
      transform: translate(-50%,-50%);
      transition: transform .15s ease, background .2s;
    }
    body:has(a:hover) #cursor,
    body:has(button:hover) #cursor { transform: translate(-50%,-50%) scale(2); background: rgba(200,145,90,.15); }

    /* ─── NAV ─── */
    nav {
      position: fixed; top: 0; width: 100%; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 5%;
      background: rgba(250,246,241,.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--sand);
    }
    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem; font-weight: 900;
      color: var(--walnut); text-decoration: none;
      letter-spacing: -.5px;
    }
    .logo span { color: var(--oak); }
    .nav-links { display: flex; gap: 2.4rem; list-style: none; }
    .nav-links a {
      font-size: .9rem; font-weight: 500; letter-spacing: .05em;
      text-decoration: none; color: var(--walnut);
      position: relative; padding-bottom: 2px;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: 0; left: 0;
      width: 0; height: 1px; background: var(--oak);
      transition: width .3s;
    }
    .nav-links a:hover::after { width: 100%; }
    .nav-cta {
      background: var(--walnut); color: var(--cream) !important;
      padding: .55rem 1.4rem; border-radius: 2px;
      font-size: .85rem !important; letter-spacing: .08em;
      text-transform: uppercase;
      transition: background .25s;
    }
    .nav-cta:hover { background: var(--rust) !important; }
    .nav-cta::after { display: none !important; }

    /* ─── HERO ─── */
    #hero {
      min-height: 100vh;
      display: grid; grid-template-columns: 1fr 1fr;
      padding-top: 80px;
      overflow: hidden;
    }
    .hero-left {
      display: flex; flex-direction: column; justify-content: center;
      padding: 6% 5% 6% 8%;
      position: relative;
    }
    .hero-tag {
      font-size: .75rem; letter-spacing: .18em; text-transform: uppercase;
      color: var(--oak); font-weight: 500; margin-bottom: 1.4rem;
      display: flex; align-items: center; gap: .6rem;
    }
    .hero-tag::before { content: ''; display: block; width: 28px; height: 1px; background: var(--oak); }
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3rem, 5.5vw, 5.2rem);
      line-height: 1.05; color: var(--dark);
      margin-bottom: 1.8rem;
    }
    h1 em { color: var(--oak); font-style: italic; }
    .hero-desc {
      font-size: 1.05rem; line-height: 1.8;
      color: #6B5040; max-width: 440px; margin-bottom: 3rem;
    }
    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-primary {
      background: var(--walnut); color: var(--cream);
      padding: .9rem 2.2rem; border: none; border-radius: 2px;
      font-family: 'DM Sans', sans-serif; font-size: .9rem;
      font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
      text-decoration: none; cursor: none;
      transition: background .25s, transform .2s;
    }
    .btn-primary:hover { background: var(--rust); transform: translateY(-2px); }
    .btn-outline {
      background: transparent; color: var(--walnut);
      padding: .9rem 2.2rem; border: 1.5px solid var(--walnut); border-radius: 2px;
      font-family: 'DM Sans', sans-serif; font-size: .9rem;
      font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
      text-decoration: none; cursor: none;
      transition: background .25s, color .25s;
    }
    .btn-outline:hover { background: var(--walnut); color: var(--cream); }

    .hero-stats {
      display: flex; gap: 2.5rem; margin-top: 3.5rem;
      padding-top: 2rem; border-top: 1px solid var(--sand);
    }
    .stat-num {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem; font-weight: 900; color: var(--walnut);
    }
    .stat-label { font-size: .8rem; color: #8A6E5A; margin-top: .1rem; }

    .hero-right {
      background: var(--walnut);
      position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .hero-right-inner {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      position: relative;
    }
    /* Wood grain SVG background */
    .wood-bg {
      position: absolute; inset: 0;
      opacity: .12;
      background-image: repeating-linear-gradient(
        2deg,
        transparent, transparent 8px,
        rgba(200,145,90,.5) 8px, rgba(200,145,90,.5) 9px
      );
    }
    .hero-tool-display {
      position: relative; z-index: 2;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 1.2rem; padding: 2rem;
    }
    .tool-card {
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(200,145,90,.25);
      border-radius: 4px; padding: 1.6rem 1.4rem;
      text-align: center;
      animation: floatUp 6s ease-in-out infinite;
    }
    .tool-card:nth-child(2) { animation-delay: 1.5s; margin-top: 1.5rem; }
    .tool-card:nth-child(3) { animation-delay: 3s; }
    .tool-card:nth-child(4) { animation-delay: 4.5s; margin-top: 1.5rem; }
    @keyframes floatUp {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }
    .tool-icon { font-size: 2.6rem; margin-bottom: .6rem; }
    .tool-name { font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--sand); font-weight: 500; }
    .tool-price { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--oak); margin-top: .3rem; }

    .hero-badge {
      position: absolute; bottom: 2.5rem; right: 2.5rem; z-index: 3;
      width: 90px; height: 90px; border-radius: 50%;
      background: var(--oak); color: var(--dark);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      text-align: center; line-height: 1.3;
      animation: spin 20s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ─── SECTION WRAPPER ─── */
    section { padding: 7rem 8%; }
    .section-label {
      font-size: .72rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--oak); font-weight: 500;
      display: flex; align-items: center; gap: .7rem; margin-bottom: 1.2rem;
    }
    .section-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--oak); }
    h2 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 1.15; color: var(--dark); margin-bottom: 1rem;
    }
    .section-desc { font-size: 1rem; color: #7A5E4E; line-height: 1.8; max-width: 520px; }

    /* ─── PRODUCTS ─── */
    #products { background: var(--light); }
    .products-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 3.5rem; flex-wrap: wrap; gap: 1.5rem; }
    .filter-tabs { display: flex; gap: .6rem; flex-wrap: wrap; }
    .tab {
      padding: .5rem 1.2rem; border: 1px solid var(--sand);
      background: transparent; border-radius: 2px;
      font-family: 'DM Sans', sans-serif; font-size: .82rem;
      color: var(--walnut); cursor: none;
      transition: all .2s;
    }
    .tab.active, .tab:hover { background: var(--walnut); color: var(--cream); border-color: var(--walnut); }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.8rem;
    }
    .product-card {
      background: #fff;
      border: 1px solid var(--sand);
      border-radius: 3px; overflow: hidden;
      transition: transform .3s, box-shadow .3s;
    }
    .product-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(59,35,20,.12); }
    .product-img {
      height: 200px;
      display: flex; align-items: center; justify-content: center;
      font-size: 4rem; position: relative;
      overflow: hidden;
    }
    .p-bg-1 { background: linear-gradient(135deg, #F5EFE6, #E8D8C3); }
    .p-bg-2 { background: linear-gradient(135deg, #E8D8C3, #D4C0A8); }
    .p-bg-3 { background: linear-gradient(135deg, #EDE8E1, #DDD4C4); }
    .product-badge {
      position: absolute; top: 1rem; left: 1rem;
      background: var(--rust); color: #fff;
      font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      padding: .25rem .6rem; border-radius: 2px;
    }
    .product-body { padding: 1.4rem; }
    .product-cat { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--oak); margin-bottom: .4rem; }
    .product-name { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--dark); margin-bottom: .6rem; }
    .product-desc { font-size: .85rem; color: #8A6E5A; line-height: 1.6; margin-bottom: 1.2rem; }
    .product-footer { display: flex; align-items: center; justify-content: space-between; }
    .product-price { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--walnut); }
    .add-btn {
      width: 38px; height: 38px; border-radius: 50%;
      background: var(--walnut); border: none; color: var(--cream);
      font-size: 1.2rem; cursor: none; display: flex; align-items: center; justify-content: center;
      transition: background .2s, transform .2s;
    }
    .add-btn:hover { background: var(--oak); transform: scale(1.1); }

    /* ─── SERVICES ─── */
    #services { background: var(--walnut); color: var(--cream); }
    #services h2 { color: var(--cream); }
    #services .section-desc { color: var(--sand); }
    .services-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem; margin-top: 3.5rem;
    }
    .service-card {
      border: 1px solid rgba(200,145,90,.3);
      border-radius: 3px; padding: 2.2rem;
      position: relative; overflow: hidden;
      transition: background .3s, border-color .3s;
    }
    .service-card::before {
      content: ''; position: absolute; top: 0; left: 0;
      width: 3px; height: 0; background: var(--oak);
      transition: height .4s ease;
    }
    .service-card:hover::before { height: 100%; }
    .service-card:hover { background: rgba(200,145,90,.08); border-color: var(--oak); }
    .service-icon { font-size: 2.4rem; margin-bottom: 1.2rem; }
    .service-name {
      font-family: 'Playfair Display', serif; font-size: 1.25rem;
      color: var(--cream); margin-bottom: .8rem;
    }
    .service-desc { font-size: .9rem; color: var(--sand); line-height: 1.7; margin-bottom: 1.5rem; }
    .service-price { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--oak); }
    .service-link {
      display: inline-flex; align-items: center; gap: .5rem;
      color: var(--oak); font-size: .85rem; text-decoration: none; font-weight: 500;
      margin-top: 1.2rem;
      transition: gap .2s;
    }
    .service-link:hover { gap: .9rem; }

    /* ─── WHY US / STRIPS ─── */
    #why { background: var(--cream); }
    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .why-visual {
      position: relative; height: 460px;
    }
    .why-block {
      position: absolute; border-radius: 3px; overflow: hidden;
      box-shadow: 0 12px 40px rgba(59,35,20,.18);
    }
    .wb-large { width: 68%; height: 75%; top: 0; left: 0; background: var(--walnut); display: flex; align-items: center; justify-content: center; font-size: 6rem; }
    .wb-small { width: 42%; height: 48%; bottom: 0; right: 0; background: var(--oak); display: flex; align-items: center; justify-content: center; font-size: 4rem; }
    .why-years {
      position: absolute; top: 48%; left: 52%;
      background: var(--rust); color: #fff;
      padding: 1.2rem 1.6rem; border-radius: 3px;
      font-family: 'Playfair Display', serif;
      text-align: center;
    }
    .why-years strong { font-size: 2.5rem; display: block; line-height: 1; }
    .why-years span { font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
    .feature-list { list-style: none; margin-top: 2rem; display: flex; flex-direction: column; gap: 1.2rem; }
    .feature-list li {
      display: flex; align-items: flex-start; gap: 1rem;
      font-size: .95rem; line-height: 1.6; color: #5A3E30;
    }
    .feature-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: .1rem; }

    /* ─── TESTIMONIALS ─── */
    #testimonials { background: var(--light); }
    .testi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
    .testi-card {
      background: #fff; border: 1px solid var(--sand); border-radius: 3px; padding: 2rem;
    }
    .stars { color: var(--oak); font-size: 1rem; margin-bottom: 1rem; letter-spacing: 2px; }
    .testi-text { font-size: .95rem; line-height: 1.8; color: #5A3E30; font-style: italic; margin-bottom: 1.5rem; }
    .testi-author { display: flex; align-items: center; gap: .8rem; }
    .avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--sand); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
    .author-name { font-weight: 600; font-size: .9rem; color: var(--dark); }
    .author-role { font-size: .78rem; color: #8A6E5A; }

    /* ─── CTA STRIP ─── */
    #cta-strip {
      background: var(--oak);
      padding: 5rem 8%;
      display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
    }
    #cta-strip h2 { color: var(--dark); font-size: clamp(1.8rem, 3vw, 2.6rem); max-width: 500px; }
    #cta-strip p { color: var(--walnut); font-size: .95rem; margin-top: .6rem; max-width: 420px; line-height: 1.6; }
    .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-dark { background: var(--dark); color: var(--cream); padding: .9rem 2rem; border-radius: 2px; text-decoration: none; font-size: .9rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; transition: background .2s; cursor: none; }
    .btn-dark:hover { background: var(--walnut); }
    .btn-white { background: #fff; color: var(--dark); padding: .9rem 2rem; border-radius: 2px; text-decoration: none; font-size: .9rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; transition: opacity .2s; cursor: none; }
    .btn-white:hover { opacity: .85; }

    /* ─── CONTACT ─── */
    #contact { background: var(--light); }
    .contact-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 5rem; align-items: start; margin-top: 3rem; }
    .contact-info { display: flex; flex-direction: column; gap: 2rem; }
    .info-item { display: flex; gap: 1rem; align-items: flex-start; }
    .info-icon { width: 44px; height: 44px; border-radius: 2px; background: var(--sand); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
    .info-label { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--oak); font-weight: 500; margin-bottom: .2rem; }
    .info-val { font-size: .95rem; color: var(--walnut); line-height: 1.5; }
    form { display: flex; flex-direction: column; gap: 1.2rem; }
    label { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--walnut); font-weight: 500; display: block; margin-bottom: .4rem; }
    input, textarea, select {
      width: 100%; background: #fff; border: 1px solid var(--sand);
      padding: .8rem 1rem; border-radius: 2px; font-family: 'DM Sans', sans-serif;
      font-size: .95rem; color: var(--dark);
      transition: border-color .2s;
      outline: none;
    }
    input:focus, textarea:focus, select:focus { border-color: var(--oak); }
    textarea { resize: vertical; min-height: 120px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .submit-btn {
      background: var(--walnut); color: var(--cream);
      padding: 1rem 2.5rem; border: none; border-radius: 2px;
      font-family: 'DM Sans', sans-serif; font-size: .9rem;
      font-weight: 500; letter-spacing: .08em; text-transform: uppercase;
      cursor: none; align-self: flex-start;
      transition: background .25s, transform .2s;
    }
    .submit-btn:hover { background: var(--rust); transform: translateY(-2px); }

    /* ─── FOOTER ─── */
    footer {
      background: var(--dark); color: var(--sand);
      padding: 4rem 8% 2rem;
    }
    .footer-top { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }
    .footer-brand .logo { font-size: 1.3rem; color: var(--cream); }
    .footer-brand p { font-size: .88rem; color: #8A7060; margin-top: 1rem; line-height: 1.7; max-width: 260px; }
    .footer-col h4 { font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; color: var(--oak); margin-bottom: 1.2rem; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .7rem; }
    .footer-col ul a { font-size: .88rem; color: #8A7060; text-decoration: none; transition: color .2s; }
    .footer-col ul a:hover { color: var(--oak); }
    .footer-bottom { border-top: 1px solid #2A1A10; padding-top: 1.5rem; display: flex; align-items: center; justify-content: space-between; font-size: .8rem; color: #6A5040; }
    .socials { display: flex; gap: .8rem; }
    .social-icon { width: 36px; height: 36px; border: 1px solid #3A2A1A; border-radius: 2px; display: flex; align-items: center; justify-content: center; font-size: .9rem; text-decoration: none; color: #8A7060; transition: border-color .2s, color .2s; }
    .social-icon:hover { border-color: var(--oak); color: var(--oak); }

    /* ─── MARQUEE ─── */
    .marquee-strip {
      background: var(--oak); padding: 1rem 0; overflow: hidden;
      white-space: nowrap;
    }
    .marquee-inner { display: inline-block; animation: marquee 22s linear infinite; }
    .marquee-inner span { font-size: .78rem; letter-spacing: .15em; text-transform: uppercase; font-weight: 600; color: var(--dark); padding: 0 2.5rem; }
    .marquee-inner span::before { content: '✦'; margin-right: 2.5rem; }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* ─── SCROLL ANIMATION ─── */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 900px) {
      #hero { grid-template-columns: 1fr; }
      .hero-right { display: none; }
      .why-grid { grid-template-columns: 1fr; }
      .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .footer-top { grid-template-columns: 1fr 1fr; }
      .form-row { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      section { padding: 5rem 5%; }
      .footer-top { grid-template-columns: 1fr; }
      nav { padding: 1rem 5%; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

<div id="cursor"></div>

<!-- NAV -->
<nav>
  <a href="#" class="logo">Grained<span>&</span>Grain</a>
  <ul class="nav-links">
    <li><a href="#products">Shop Tools</a></li>
    <li><a href="#services">Services</a></li>
    <li><a href="#why">About</a></li>
    <li><a href="#contact" class="nav-cta">Get a Quote</a></li>
  </ul>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-left reveal">
    <div class="hero-tag">Crafted for craftsmen</div>
    <h1>Tools Built for the <em>Grain.</em></h1>
    <p class="hero-desc">Premium carpenter tools, hand-selected for professionals and serious makers. Plus expert carpentry services — from custom furniture to full renovations.</p>
    <div class="hero-btns">
      <a href="#products" class="btn-primary">Shop Tools</a>
      <a href="#services" class="btn-outline">Our Services</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="stat-num">400+</div>
        <div class="stat-label">Tools in stock</div>
      </div>
      <div>
        <div class="stat-num">18yr</div>
        <div class="stat-label">Experience</div>
      </div>
      <div>
        <div class="stat-num">2.1k</div>
        <div class="stat-label">Happy clients</div>
      </div>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-right-inner">
      <div class="wood-bg"></div>
      <div class="hero-tool-display">
        <div class="tool-card">
          <div class="tool-icon">🪚</div>
          <div class="tool-name">Hand Saw</div>
          <div class="tool-price">$49</div>
